<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\StockIssueSystem.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
  <!-- ให้ IIS ส่งรูปจาก Virtual Directory โดยไม่ส่งคำขอเข้า ASP.NET Core -->
  <location path="StockIssueSystemimg">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
      </handlers>
      <directoryBrowse enabled="false" />
    </system.webServer>
  </location>
</configuration>